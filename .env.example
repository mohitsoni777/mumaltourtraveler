# Copy this file to ".env" for local testing (never upload .env anywhere).
# On Vercel, add the same keys in: Project → Settings → Environment Variables.

# Mailbox that sends the booking emails (Gmail or Google Workspace)
SMTP_USER=yourname@gmail.com
# Gmail "App Password" (16 characters) — NOT your normal Gmail password
SMTP_PASS=xxxx xxxx xxxx xxxx

# Where booking enquiries are delivered
BOOKING_TO=paramveersingh2822@gmail.com

# Optional
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SEND_CUSTOMER_CONFIRMATION=0
